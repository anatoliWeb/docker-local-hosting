# Docker Local Hosting — приклад налаштувань
# Скопіюйте: Copy-Item .env.example .env

# Основна локальна доменна зона
LOCAL_DOMAIN=home.arpa

# Хости центральних сервісів
TRAEFIK_DASHBOARD_HOST=traefik.home.arpa
DEMO_HOST=demo.home.arpa

# Часовий пояс
TZ=Europe/Kyiv

# Назва Compose-проєкту
COMPOSE_PROJECT_NAME=docker-local-hosting

# Зовнішня Docker-мережа
LOCAL_HOSTING_NETWORK=local-hosting

# Шляхи до сертифіката та ключа (відносно кореня проєкту)
TLS_CERT_FILE=./certs/home.arpa.pem
TLS_KEY_FILE=./certs/home.arpa-key.pem

# Домени сертифіката (через пробіл)
MKCERT_DOMAINS=home.arpa *.home.arpa

# Автоматизація
AUTO_CREATE_NETWORK=true

# Версії образів
NGINX_VERSION=1.27-alpine
TRAEFIK_VERSION=v3.7.9
DOCKER_SOCKET_PROXY_VERSION=v0.4.2
ALPINE_VERSION=3.20
