# Домен за замовчуванням
LOCAL_DOMAIN=home.arpa

# Хости для Traefik Dashboard i демо
TRAEFIK_DASHBOARD_HOST=traefik.home.arpa
DEMO_HOST=demo.home.arpa

# Basic Auth для Dashboard (формат: user:hash)
# Як створити hash: echo $(htpasswd -nb admin your-password) | sed -e 's/\$/\$\$/g'
# Приклад: admin:$2y$10$...
TRAEFIK_BASIC_AUTH=

# Часовий пояс
TZ=Europe/Kyiv

# Назва проєкту Docker Compose
COMPOSE_PROJECT_NAME=docker-local-hosting
